# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Starter content, permanently.
#
# These files were deleted early on and kept reappearing on disk with their
# original mtimes -- something outside the repo restores them. Astro's content
# loader globs the filesystem, so a restored week-02.md silently shadows the
# real week-02.mdx and renders starter text; and because `git add -A` picked
# them back up, they kept re-entering the history too.
#
# Ignoring them makes the second failure impossible. spec/no-starter-remains.ts
# catches the first, by asserting the built API node-for-node.
src/content/lectures/week-01.md
src/content/lectures/week-02.md
src/content/sessions/01-getting-started.md
src/content/sessions/02-first-review.md
src/content/assessments/assignment-1.md
src/content/assessments/final-project.md
src/content/people/idris-fenn.md
src/content/people/idris-fenn.avif
src/content/people/marisol-quaye.md
src/content/people/marisol-quaye.avif

# Deleted in this round but restored on disk by something on this machine
# (cause never found; ten starter files do the same with their original Sep 4
# mtimes). Ignored so a git add -A cannot quietly resurrect them in a commit.
src/components/diagrams/CafeLayouts.astro
src/pages/simcheck.astro
src/components/diagrams/FeedbackLoop.astro
src/components/diagrams/Figure.astro
src/components/diagrams/GanttCompare.astro
src/components/diagrams/LittlesLawArea.astro
src/components/diagrams/Panel.astro
src/components/diagrams/TriageOrder.astro
src/components/diagrams/TwoSystems.astro
src/components/diagrams/WaitBill.astro
src/components/diagrams/WaitMoved.astro

# Scratch measurement harnesses: run by hand, never shipped.
spec/tmp-*.test.ts
