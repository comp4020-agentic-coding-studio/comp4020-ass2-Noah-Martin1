---
/**
 * The course's one simulation component.
 *
 * Weeks 2, 5, 8 and 10 all render this. Configuring it rather than writing four
 * bespoke animations is what keeps the visual grammar identical across the
 * semester: same frame, same readout row, same controls, same caption slot.
 *
 * `watch` is required, not optional. A simulation that cannot say what it is
 * demonstrating is decoration, and spec/simulations.test.ts fails the build if
 * one ships without a caption.
 */
import "../styles/course.css";

export type SimVariant = "rho" | "lanes" | "express" | "boarding";

interface Props {
  variant: SimVariant;
  /** What the reader should look at. Rendered as the figure caption. */
  watch: string;
  /** Text alternative describing the diagram for anyone not seeing it. */
  alt: string;
  id: string;
}

const { variant, watch, alt, id } = Astro.props;

const HEIGHTS: Record<SimVariant, number> = {
  rho: 156,
  lanes: 250,
  express: 196,
  boarding: 208,
};
---

<figure class="q-figure qsim" data-qsim data-variant={variant} id={id}>
  <div class="q-figure__stage">
    <canvas
      class="qsim__canvas"
      data-qsim-canvas
      data-height={HEIGHTS[variant]}
      role="img"
      aria-label={alt}></canvas>
  </div>

  <dl class="qsim__readout" data-qsim-readout>
    {variant === "boarding" ? (
      <>
        <div><dt>Seated</dt><dd data-r="seated">—</dd></div>
        <div><dt>Tick</dt><dd data-r="tick">—</dd></div>
        <div><dt>Full run</dt><dd data-r="full">—</dd></div>
        <div><dt>vs back to front</dt><dd data-r="delta">—</dd></div>
      </>
    ) : (
      <>
        <div><dt>λ</dt><dd data-r="lambda">—</dd></div>
        <div><dt>μ</dt><dd data-r="mu">—</dd></div>
        <div><dt>ρ</dt><dd data-r="rho">—</dd></div>
        <div><dt>L</dt><dd data-r="L">—</dd></div>
        <div><dt>W</dt><dd data-r="W">—</dd></div>
        <div><dt>W<span>90</span></dt><dd data-r="W90">—</dd></div>
      </>
    )}
  </dl>

  <div class="qsim__controls">
    <button type="button" class="qsim__play" data-qsim-play aria-pressed="false">
      Play
    </button>

    {variant === "rho" && (
      <>
        <div class="qsim__control">
          <label for={`${id}-load`}>Load (ρ) <output data-out="load">0.80</output></label>
          <input id={`${id}-load`} data-qsim-input="load" type="range"
            min="40" max="97" value="80" step="1" />
        </div>
        <div class="qsim__control">
          <label for={`${id}-var`}>Variability <output data-out="var">1.00</output></label>
          <input id={`${id}-var`} data-qsim-input="var" type="range"
            min="0" max="100" value="100" step="1" />
        </div>
      </>
    )}

    {variant === "lanes" && (
      <div class="qsim__control">
        <label for={`${id}-load`}>Load (ρ) <output data-out="load">0.85</output></label>
        <input id={`${id}-load`} data-qsim-input="load" type="range"
          min="40" max="95" value="85" step="1" />
      </div>
    )}

    {variant === "express" && (
      <div class="qsim__control">
        <label for={`${id}-share`}>Buying priority <output data-out="share">30%</output></label>
        <input id={`${id}-share`} data-qsim-input="share" type="range"
          min="0" max="80" value="30" step="5" />
      </div>
    )}

    {variant === "boarding" && (
      <div class="qsim__control qsim__control--select">
        <label for={`${id}-strategy`}>Boarding order</label>
        <select id={`${id}-strategy`} data-qsim-input="strategy">
          <option value="back-to-front">Back to front</option>
          <option value="random">Random</option>
          <option value="outside-in">Outside in (WILMA)</option>
          <option value="steffen">Steffen</option>
        </select>
      </div>
    )}

    <button type="button" class="qsim__reset" data-qsim-reset>Reset</button>
  </div>

  <figcaption class="q-figure__caption">
    <b>What to watch:</b> {watch}
  </figcaption>
</figure>


<script>
  import { QueueSim, BoardingSim, type BoardingStrategy, type SimConfig } from "../lib/queue-sim";

  type Variant = "rho" | "lanes" | "express" | "boarding";

  const MU = 0.2;
  /** Ticks of headless simulation behind the printed statistics. */
  const STATS_TICKS = 20000;
  /** Sim ticks advanced per real second while animating. */
  const TICKS_PER_SEC = 14;

  type Ink = { ink: string; soft: string; gold: string; rule: string; bg: string };

  /**
   * Canvas needs real colours, and reading the custom properties directly does
   * not give them: the theme defines its tokens as light-dark() pairs, which
   * getPropertyValue hands back verbatim. Assigning that to strokeStyle fails
   * silently and the context keeps whatever colour it had, which is how every
   * rule and label on this canvas came out gold.
   *
   * Setting `color` on a probe element and reading it back makes the browser
   * resolve light-dark(), var() and everything else to an rgb() triple.
   */
  function readInk(root: HTMLElement): Ink {
    const probe = document.createElement("span");
    probe.style.display = "none";
    root.appendChild(probe);
    const get = (value: string, fallback: string) => {
      probe.style.color = "";
      probe.style.color = value;
      const resolved = getComputedStyle(probe).color;
      return resolved && resolved !== "rgba(0, 0, 0, 0)" ? resolved : fallback;
    };
    const colours: Ink = {
      ink: get("var(--q-ink)", "#222"),
      soft: get("var(--q-ink-soft)", "#777"),
      gold: get("var(--q-gold)", "#b97d1c"),
      rule: get("var(--q-rule)", "#ccc"),
      bg: get("var(--at-bg)", "#fff"),
    };
    probe.remove();
    return colours;
  }

  function setupOne(root: HTMLElement) {
    if (root.dataset.qsimReady === "1") return;
    root.dataset.qsimReady = "1";

    const variant = (root.dataset.variant ?? "rho") as Variant;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-qsim-canvas]");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-qsim-play]");
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-qsim-reset]");
    const readout = root.querySelector<HTMLElement>("[data-qsim-readout]");
    if (!canvas || !playBtn || !resetBtn || !readout) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const cssHeight = Number(canvas.dataset.height ?? 160);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const controls: Record<string, HTMLInputElement | HTMLSelectElement> = {};
    root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-qsim-input]").forEach((el) => {
      controls[el.dataset.qsimInput as string] = el;
    });

    const num = (key: string, fallback: number) =>
      controls[key] ? Number((controls[key] as HTMLInputElement).value) : fallback;

    let colours = readInk(root);
    const themeWatcher = new MutationObserver(() => { colours = readInk(root); draw(); });
    themeWatcher.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    /** Rolling queue-length history, so the left of the canvas shows the run. */
    let history: number[] = [];
    let visual: QueueSim[] = [];
    let boarding: BoardingSim | null = null;
    let playing = false;
    let raf = 0;
    let last = 0;
    let carry = 0;

    /** Build the configs this variant needs. Index 0 is always the main panel. */
    function configs(): SimConfig[] {
      const base = {
        seed: 7, servers: 1, lanes: 1, lambda: MU * 0.8, mu: MU,
        serviceCv: 1, arrivalCv: 1, discipline: "fcfs" as const, priorityShare: 0,
      };
      if (variant === "rho") {
        const rho = num("load", 80) / 100;
        const v = num("var", 100) / 100;
        return [{ ...base, lambda: MU * rho, serviceCv: v, arrivalCv: v }];
      }
      if (variant === "lanes") {
        const rho = num("load", 85) / 100;
        const lambda = MU * 4 * rho;
        return [
          { ...base, servers: 4, lanes: 1, lambda },
          { ...base, servers: 1, lanes: 4, lambda },
        ];
      }
      // express
      const share = num("share", 30) / 100;
      return [{
        ...base, servers: 2, lanes: 1, lambda: MU * 2 * 0.85,
        discipline: "priority" as const, priorityShare: share,
      }];
    }

    function rebuild() {
      if (variant === "boarding") {
        const strategy = (controls.strategy?.value ?? "back-to-front") as BoardingStrategy;
        boarding = new BoardingSim(strategy, 12, 6, 7);
        if (reduced.matches) { let g = 0; while (!boarding.done && g++ < 20000) boarding.step(); }
        else { for (let i = 0; i < 80; i++) boarding.step(); }
      } else {
        visual = configs().map((c) => new QueueSim(c, 0));
        // Open on a populated queue rather than an empty one. A first paint
        // showing nothing teaches nothing, and it is what a reader who never
        // presses play, or who has reduced motion on, will be looking at.
        history = [];
        const warm = reduced.matches ? 600 : 260;
        for (let i = 0; i < warm; i++) { visual[0].step(); visual.slice(1).forEach((s) => s.step()); history.push(visual[0].inSystem); }
      }
      refreshStats();
      draw();
    }

    /** Statistics come from a long headless run, never from what is on screen. */
    function refreshStats() {
      const out = (key: string, value: string) => {
        const el = readout!.querySelector(`[data-r="${key}"]`);
        if (el) el.textContent = value;
      };

      if (variant === "boarding") {
        if (!boarding) return;
        const strategy = boarding.strategy;
        const full = BoardingSim.timeFor(strategy, 12, 6, 7);
        const baseline = BoardingSim.timeFor("back-to-front", 12, 6, 7);
        const delta = Math.round(((full - baseline) / baseline) * 100);
        out("seated", `${boarding.seated}/${boarding.rows * boarding.cols}`);
        out("tick", String(boarding.tick));
        out("full", `${full} ticks`);
        out("delta", strategy === "back-to-front" ? "baseline" : `${delta > 0 ? "+" : ""}${delta}%`);
        return;
      }

      const cfgs = configs();
      const headless = cfgs.map((c) => { const s = new QueueSim(c); s.run(STATS_TICKS); return s; });
      const main = headless[0];
      const st = main.stats();

      out("lambda", main.config.lambda.toFixed(2));
      out("mu", main.config.mu.toFixed(2));
      out("rho", main.rho.toFixed(2));

      if (variant === "lanes") {
        const b = headless[1].stats();
        out("L", `${st.L.toFixed(1)} / ${b.L.toFixed(1)}`);
        out("W", `${st.W.toFixed(1)} / ${b.W.toFixed(1)}`);
        out("W90", `${st.W90} / ${b.W90}`);
      } else if (variant === "express") {
        out("L", st.L.toFixed(1));
        out("W", `${st.Wpriority.toFixed(1)} / ${st.Wstandard.toFixed(1)}`);
        out("W90", String(st.W90));
      } else {
        out("L", st.L.toFixed(1));
        out("W", st.W.toFixed(1));
        out("W90", String(st.W90));
      }
    }

    function sizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = root.clientWidth || 600;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(cssHeight * dpr);
      canvas!.style.height = `${cssHeight}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { w, h: cssHeight };
    }

    // --- drawing primitives, in the two-ink grammar -----------------------
    function person(c: CanvasRenderingContext2D, x: number, y: number, served: boolean, col: Ink) {
      c.beginPath();
      c.arc(x, y, 5, 0, Math.PI * 2);
      if (served) { c.fillStyle = col.gold; c.fill(); }
      else { c.strokeStyle = col.ink; c.lineWidth = 1.5; c.stroke(); }
    }

    function serverBox(c: CanvasRenderingContext2D, x: number, y: number, busy: boolean, col: Ink) {
      c.beginPath();
      c.rect(x - 9, y - 9, 18, 18);
      c.strokeStyle = busy ? col.gold : col.rule;
      c.lineWidth = busy ? 2.5 : 1.5;
      c.stroke();
    }

    function label(c: CanvasRenderingContext2D, text: string, x: number, y: number, col: string, size = 11, align: CanvasTextAlign = "left") {
      c.fillStyle = col;
      c.font = `${size}px ui-sans-serif, system-ui, sans-serif`;
      c.textAlign = align;
      c.fillText(text, x, y);
    }

    /** One queue on one baseline: dots flowing right into a server box. */
    function drawLane(c: CanvasRenderingContext2D, sim: QueueSim, laneIndex: number, y: number, w: number, col: Ink, caption?: string, left = 58) {
      // Rightmost box must sit fully inside the canvas: its centre plus half a
      // box plus a margin. Anchoring from the left ran the last one off-screen.
      const serverX = w - 22 - (sim.config.servers - 1) * 26;
      if (caption) label(c, caption, left, y - 22, col.soft, 11);

      // An arrivals marker at the mouth of the lane. Without it a lane holding
      // three people looks like a rendering failure rather than a short queue.
      label(c, "in", left - 44, y + 4, col.soft, 10);
      c.beginPath();
      c.moveTo(left - 28, y);
      c.lineTo(left - 8, y);
      c.strokeStyle = col.soft;
      c.lineWidth = 1;
      c.stroke();
      c.beginPath();
      c.moveTo(left - 12, y - 3.5);
      c.lineTo(left - 8, y);
      c.lineTo(left - 12, y + 3.5);
      c.stroke();

      c.beginPath();
      c.moveTo(left, y);
      c.lineTo(w - 14, y);
      c.strokeStyle = col.rule;
      c.lineWidth = 1;
      c.setLineDash([2, 4]);
      c.stroke();
      c.setLineDash([]);

      for (let s = 0; s < sim.config.servers; s++) {
        serverBox(c, serverX + s * 26, y, Boolean(sim.busy[laneIndex]?.[s]), col);
        const cust = sim.busy[laneIndex]?.[s];
        if (cust) person(c, serverX + s * 26, y, true, col);
      }

      const queue = sim.queues[laneIndex] ?? [];
      const startX = serverX - 34;
      const shown = Math.min(queue.length, Math.max(0, Math.floor((startX - left) / 13)));
      for (let i = 0; i < shown; i++) {
        person(c, startX - i * 13, y, false, col);
      }
      if (queue.length > shown) {
        label(c, `+${queue.length - shown}`, left, y + 4, col.soft, 10, "left");
      }
    }

    function draw() {
      const { w, h } = sizeCanvas();
      const col = colours;
      ctx!.clearRect(0, 0, w, h);

      if (variant === "boarding" && boarding) {
        drawBoarding(ctx!, boarding, w, h, col);
        return;
      }
      if (!visual.length) return;

      if (variant === "rho") {
        drawLane(ctx!, visual[0], 0, 40, w, col);
        drawHistory(ctx!, 58, 68, w - 72, 66, col);
        const n = visual[0].inSystem;
        label(ctx!, `${n} in system now · tick ${visual[0].tick}`, 58, 150, col.soft, 11);
      } else if (variant === "lanes") {
        drawLane(ctx!, visual[0], 0, 46, w, col, "One line, four servers", 58);
        for (let l = 0; l < 4; l++) {
          drawLane(ctx!, visual[1], l, 132 + l * 30, w, col, l === 0 ? "Four lines, one server each" : undefined, 58);
        }
      } else if (variant === "express") {
        const sim = visual[0];
        const priority = sim.queues[0].filter((c) => c.priority);
        const standard = sim.queues[0].filter((c) => !c.priority);
        label(ctx!, "Priority", 20, 34, col.gold, 11);
        const qStart = w - 68;
        for (let i = 0; i < Math.min(priority.length, Math.floor((qStart - 20) / 13)); i++) {
          ctx!.beginPath(); ctx!.arc(qStart - i * 13, 52, 5, 0, Math.PI * 2);
          ctx!.strokeStyle = col.gold; ctx!.lineWidth = 2; ctx!.stroke();
        }
        label(ctx!, "Standard", 20, 104, col.soft, 11);
        for (let i = 0; i < Math.min(standard.length, Math.floor((qStart - 20) / 13)); i++) {
          person(ctx!, qStart - i * 13, 122, false, col);
        }
        for (let s = 0; s < 2; s++) {
          const cust = sim.busy[0][s];
          serverBox(ctx!, w - 26, 52 + s * 70, Boolean(cust), col);
          if (cust) person(ctx!, w - 26, 52 + s * 70, true, col);
        }
        label(ctx!, `${priority.length} priority · ${standard.length} standard waiting`, 20, 168, col.soft, 11);
      }
    }

    /** Queue length over the run so far. The shape is the lesson. */
    function drawHistory(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, col: Ink) {
      if (history.length < 2) return;
      const peak = Math.max(4, ...history);
      const span = Math.min(history.length, 600);
      const from = history.length - span;

      c.beginPath();
      c.moveTo(x, y + h);
      c.lineTo(x + w, y + h);
      c.strokeStyle = col.rule;
      c.lineWidth = 1;
      c.stroke();

      c.beginPath();
      for (let i = 0; i < span; i++) {
        const px = x + (i / (span - 1)) * w;
        const py = y + h - (history[from + i] / peak) * h;
        if (i === 0) c.moveTo(px, py);
        else c.lineTo(px, py);
      }
      c.strokeStyle = col.gold;
      c.lineWidth = 1.5;
      c.stroke();

      c.lineTo(x + w, y + h);
      c.lineTo(x, y + h);
      c.closePath();
      c.globalAlpha = 0.12;
      c.fillStyle = col.gold;
      c.fill();
      c.globalAlpha = 1;

      label(c, `peak ${peak}`, x, y - 4, col.soft, 10);
      label(c, "queue length over the run", x + w, y - 4, col.soft, 10, "right");
    }

    function drawBoarding(c: CanvasRenderingContext2D, sim: BoardingSim, w: number, h: number, col: Ink) {
      const rows = sim.rows;
      const perSide = sim.cols / 2;
      const seatH = 14;
      const gap = 3;
      const aisleGap = 16;

      const cw = Math.min((w - 40) / rows, 52);
      const cabinW = cw * rows;
      const left = (w - cabinW) / 2;
      const top = 34;
      const sideH = perSide * (seatH + gap);
      const aisleY = top + sideH + aisleGap / 2;

      label(c, `${sim.strategy} · tick ${sim.tick} · ${sim.seated} of ${rows * sim.cols} seated`, left, 20, col.soft, 11);
      label(c, "front", left, aisleY + 4, col.soft, 10, "right");

      // Seat y for a column: 1..3 above the aisle (1 = window, furthest),
      // 4..6 below it (6 = window, furthest).
      const seatY = (colIndex: number) => {
        const above = colIndex < perSide;
        const rank = above ? colIndex : colIndex - perSide;
        return above
          ? top + rank * (seatH + gap)
          : aisleY + aisleGap / 2 + rank * (seatH + gap);
      };

      for (let r = 0; r < rows; r++) {
        const x = left + r * cw;
        for (let s = 0; s < sim.cols; s++) {
          const y = seatY(s);
          c.beginPath();
          c.rect(x + 2, y, Math.max(cw - 4, 6), seatH);
          c.strokeStyle = col.rule;
          c.lineWidth = 1;
          c.stroke();
          if (sim.seatedGrid[r]?.[s]) {
            c.beginPath();
            c.arc(x + cw / 2, y + seatH / 2, 4, 0, Math.PI * 2);
            c.fillStyle = col.gold;
            c.globalAlpha = 0.55;
            c.fill();
            c.globalAlpha = 1;
          }
        }
      }

      c.beginPath();
      c.moveTo(left, aisleY);
      c.lineTo(left + cabinW, aisleY);
      c.strokeStyle = col.rule;
      c.lineWidth = 1;
      c.setLineDash([2, 4]);
      c.stroke();
      c.setLineDash([]);

      for (let r = 0; r < rows; r++) {
        const walker = sim.aisle[r];
        if (!walker) continue;
        const x = left + r * cw + cw / 2;
        const stowing = walker.at === walker.seatRow - 1;
        c.beginPath();
        c.arc(x, aisleY, 5.5, 0, Math.PI * 2);
        if (stowing) {
          c.fillStyle = col.gold;
          c.fill();
        } else {
          c.strokeStyle = col.ink;
          c.lineWidth = 1.5;
          c.stroke();
        }
      }

      const barY = h - 22;
      label(c, `${sim.queue.length} still on the jetway`, left, barY - 8, col.soft, 11);
      c.strokeStyle = col.rule;
      c.lineWidth = 1;
      c.strokeRect(left, barY, cabinW, 6);
      c.fillStyle = col.gold;
      c.fillRect(left, barY, cabinW * (sim.seated / (rows * sim.cols)), 6);
    }

    // --- loop -------------------------------------------------------------
    function frame(now: number) {
      if (!playing) return;
      const dt = Math.min((now - last) / 1000, 0.25);
      last = now;
      carry += dt * TICKS_PER_SEC;
      const steps = Math.floor(carry);
      carry -= steps;
      for (let i = 0; i < steps; i++) {
        if (variant === "boarding") {
          if (boarding && !boarding.done) boarding.step();
        } else {
          visual.forEach((s) => s.step());
          history.push(visual[0].inSystem);
          if (history.length > 900) history.shift();
        }
      }
      if (variant === "boarding") { refreshStats(); if (boarding?.done) stop(); }
      draw();
      raf = requestAnimationFrame(frame);
    }

    function play() {
      if (playing) return;
      playing = true;
      playBtn!.textContent = "Pause";
      playBtn!.setAttribute("aria-pressed", "true");
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      playing = false;
      playBtn!.textContent = "Play";
      playBtn!.setAttribute("aria-pressed", "false");
      cancelAnimationFrame(raf);
    }

    playBtn.addEventListener("click", () => (playing ? stop() : play()));
    resetBtn.addEventListener("click", () => { stop(); rebuild(); });

    Object.entries(controls).forEach(([key, el]) => {
      el.addEventListener("input", () => {
        const out = root.querySelector(`[data-out="${key}"]`);
        if (out) {
          const v = Number((el as HTMLInputElement).value);
          out.textContent = key === "share" ? `${v}%` : (v / 100).toFixed(2);
        }
        const wasPlaying = playing;
        stop();
        rebuild();
        if (wasPlaying && !reduced.matches) play();
      });
    });

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(draw, 120);
    };
    window.addEventListener("resize", onResize);
    document.addEventListener("astro:before-swap", () => { stop(); window.removeEventListener("resize", onResize); }, { once: true });

    rebuild();
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-qsim]").forEach(setupOne);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
