---
/**
 * Week 11: the loop that makes an accurate wait estimate self-defeating.
 *
 * Drawn as a cycle because the point is that it has no start. Every model
 * before this week treated the things in the queue as jobs, which do not react
 * to being told how long they will wait. People do, and the reaction changes
 * the very number they were told.
 */
import Figure from "./Figure.astro";

const STEPS = [
  { t: "The queue grows", d: "More people are waiting than a minute ago." },
  { t: "The sign updates", d: "“Estimated wait: 40 minutes.” Accurate, for now." },
  { t: "People read it and leave", d: "Some balk before joining. Some renege and go." },
  { t: "The queue shrinks", d: "The wait falls — so the sign is now wrong, because it was shown." },
];

const SIZE = 260;
const C = SIZE / 2;
const R = 82;
const at = (i: number) => {
  const a = (i / STEPS.length) * Math.PI * 2 - Math.PI / 2;
  return { x: C + R * Math.cos(a), y: C + R * Math.sin(a) };
};

/** Arc between two nodes, stopping short of each so the arrow reads. */
function arc(i: number) {
  const pad = 0.38;
  const step = (Math.PI * 2) / STEPS.length;
  const a0 = (i / STEPS.length) * Math.PI * 2 - Math.PI / 2 + pad;
  const a1 = a0 + step - pad * 2;
  const p = (a: number) => `${(C + R * Math.cos(a)).toFixed(1)} ${(C + R * Math.sin(a)).toFixed(1)}`;
  return { d: `M ${p(a0)} A ${R} ${R} 0 0 1 ${p(a1)}`, head: a1 };
}
---

<Figure
  columns={1}
  caption="There is no first step here, which is the difficulty. Publish an accurate estimate and some people act on it; once they act on it, the estimate describes a queue that no longer exists. The number is only correct for the world in which it was not shown. That is not a bug to engineer away — it is what publishing information about a system to the system's own participants means."
>
  <div class="q-panel">
    <svg viewBox={`0 0 ${SIZE} ${SIZE}`} class="q-svg loop" role="img"
      aria-label="A four-step cycle: the queue grows, the sign updates with an accurate estimate, people read it and leave, the queue shrinks, which makes the estimate wrong — and the cycle repeats.">
      <defs>
        <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5"
          markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="q-fill" />
        </marker>
      </defs>
      {STEPS.map((_, i) => (
        <path d={arc(i).d} class="q-line--gold" marker-end="url(#loop-arrow)" fill="none" />
      ))}
      {STEPS.map((_, i) => {
        const p = at(i);
        return (
          <>
            <circle cx={p.x} cy={p.y} r="17" fill="var(--at-bg)" class="q-box" />
            <text x={p.x} y={p.y + 5} text-anchor="middle" class="loop-n">{i + 1}</text>
          </>
        );
      })}
    </svg>
    <ol class="loop-key">
      {STEPS.map((s) => (
        <li><b>{s.t}</b> — {s.d}</li>
      ))}
    </ol>
  </div>
</Figure>

<style>
  .loop { max-width: 260px; margin-inline: auto; }
  .loop-n { font-size: 14px; font-weight: 700; fill: var(--q-ink); }

  .loop-key {
    margin: 1rem 0 0;
    padding-left: 1.35rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--q-ink-soft);
  }
  .loop-key li { margin-bottom: 0.3rem; }
  .loop-key b { color: var(--q-ink); }

  @media (min-width: 40rem) {
    .q-panel:has(> .loop) {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 1.5rem;
      align-items: center;
    }
    .loop-key { margin-top: 0; }
  }
</style>
