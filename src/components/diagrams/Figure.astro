---
/**
 * The frame every static diagram sits in — the same frame QueueSim uses, so a
 * drawn diagram and a live simulation read as the same kind of object.
 */
import "../../styles/course.css";

interface Props {
  /** What the reader should take from it. Required, same rule as QueueSim. */
  caption: string;
  /** 2 or 3 side-by-side panels on wide screens; always stacked on a phone. */
  columns?: 2 | 3;
  scroll?: boolean;
}

const { caption, columns = 2, scroll = false } = Astro.props;
---

<figure class="q-figure">
  <div class:list={["q-panels", `q-panels--${columns}`, scroll && "q-scroll"]}>
    <slot />
  </div>
  <figcaption class="q-figure__caption"><b>What to notice:</b> {caption}</figcaption>
</figure>
