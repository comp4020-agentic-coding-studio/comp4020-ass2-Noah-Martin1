---
/**
 * Week 6's central claim, drawn: five jobs, one server, same total work, and
 * a threefold difference in total waiting produced entirely by the order.
 *
 * Each bar is one job. The pale run-up is time that job spent waiting; the
 * solid part is it being served. Total shaded waiting is the number that moves.
 */
import Figure from "./Figure.astro";
import Panel from "./Panel.astro";

const JOBS = [1, 2, 3, 4, 10];
const TOTAL = JOBS.reduce((a, b) => a + b, 0);

const W = 300;
const H = 132;
const X0 = 14;
const X1 = W - 12;
const x = (t: number) => X0 + (t / TOTAL) * (X1 - X0);
const y = (i: number) => 14 + i * 21;
const BAR = 13;

/** Schedule jobs back to back in the given order; report each one's wait. */
function schedule(order: number[]) {
  let clock = 0;
  const rows = order.map((len) => {
    const row = { len, wait: clock, start: clock, end: clock + len };
    clock += len;
    return row;
  });
  return { rows, totalWait: rows.reduce((s, r) => s + r.wait, 0) };
}

const sjf = schedule([...JOBS].sort((a, b) => a - b));
const worst = schedule([...JOBS].sort((a, b) => b - a));
---

<Figure
  columns={2}
  caption={`Same five jobs, same single server, same ${TOTAL} minutes of total work — the server is equally busy in both. Ordering shortest-first costs ${sjf.totalWait} person-minutes of waiting; longest-first costs ${worst.totalWait}. That is three times the waiting, produced by nothing but the order, which is the closest thing to a free lunch in this course. Then look at the ten-minute job: it pays for the whole gain.`}
>
  <Panel
    title="Shortest job first"
    note={`Total waiting: <b>${sjf.totalWait} person-minutes</b>. Mean wait ${(sjf.totalWait / JOBS.length).toFixed(1)} min.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="Five job bars ordered shortest to longest. Each bar's pale leading section is waiting time; the short jobs wait almost nothing and the ten-minute job waits longest.">
      {sjf.rows.map((r, i) => (
        <>
          <rect x={x(0)} y={y(i)} width={Math.max(x(r.wait) - x(0), 0)} height={BAR} rx="2" class="q-fill--ink" />
          <rect x={x(r.start)} y={y(i)} width={x(r.end) - x(r.start)} height={BAR} rx="2"
            class={r.len === 10 ? "q-fill--soft" : "q-fill"} />
        </>
      ))}
      <line x1={X0} y1={H - 14} x2={X1} y2={H - 14} class="q-line" />
    </svg>
  </Panel>

  <Panel
    title="Longest job first"
    note={`Total waiting: <b>${worst.totalWait} person-minutes</b>. Mean wait ${(worst.totalWait / JOBS.length).toFixed(1)} min.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="The same five bars ordered longest to shortest. Every short job now sits behind a long pale waiting section, and the total shaded waiting is visibly three times larger.">
      {worst.rows.map((r, i) => (
        <>
          <rect x={x(0)} y={y(i)} width={Math.max(x(r.wait) - x(0), 0)} height={BAR} rx="2" class="q-fill--ink" />
          <rect x={x(r.start)} y={y(i)} width={x(r.end) - x(r.start)} height={BAR} rx="2"
            class={r.len === 10 ? "q-fill--soft" : "q-fill"} />
        </>
      ))}
      <line x1={X0} y1={H - 14} x2={X1} y2={H - 14} class="q-line" />
    </svg>
  </Panel>
</Figure>
