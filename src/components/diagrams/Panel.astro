---
/** One labelled cell inside a Figure. Title and note are HTML, never SVG text. */
interface Props {
  title: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<div class="q-panel">
  <h3 class="q-panel__title">{title}</h3>
  <slot />
  {note && <p class="q-panel__note" set:html={note} />}
</div>
