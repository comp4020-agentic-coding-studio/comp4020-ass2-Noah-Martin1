---
/**
 * Week 7: six people arrive at an emergency department within minutes of each
 * other. The same six, the same single treatment room, two ordering rules.
 *
 * The only difference is who goes first, and in one of the two panels the
 * chest pain is seen after seventy minutes.
 */
import Figure from "./Figure.astro";
import Panel from "./Panel.astro";

type Case = { who: string; treat: number; critical?: boolean };

// Arrival order. The critical patient turns up fifth, which is the whole point.
const CASES: Case[] = [
  { who: "Sprained wrist", treat: 15 },
  { who: "Sore throat", treat: 10 },
  { who: "Cut hand", treat: 20 },
  { who: "Back pain", treat: 25 },
  { who: "Chest pain", treat: 30, critical: true },
  { who: "Rash", treat: 10 },
];

const W = 300;
const ROW = 22;
const H = 14 + CASES.length * ROW;
const X0 = 12;
const X1 = W - 12;
const TOTAL = CASES.reduce((s, c) => s + c.treat, 0);
const x = (t: number) => X0 + (t / TOTAL) * (X1 - X0);

function run(order: Case[]) {
  let clock = 0;
  return order.map((c) => {
    const row = { ...c, start: clock, end: clock + c.treat };
    clock += c.treat;
    return row;
  });
}

const arrival = run(CASES);
const triaged = run([...CASES].sort((a, b) => Number(Boolean(b.critical)) - Number(Boolean(a.critical))));
const waitFor = (rows: ReturnType<typeof run>) => rows.find((r) => r.critical)!.start;
---

<Figure
  columns={2}
  caption={`Six people, one treatment room, identical treatment times. Ordering by arrival makes the chest pain wait ${waitFor(arrival)} minutes; ordering by urgency makes it wait ${waitFor(triaged)}. Everybody else pays about half an hour more for that, and essentially nobody objects — because the two outcomes being traded are not the same kind of thing. That asymmetry is why triage commands consent that no other priority rule in this course gets.`}
>
  <Panel
    title="First come, first served"
    note={`Chest pain seen at <b>minute ${waitFor(arrival)}</b>. Perfectly fair by arrival, and indefensible.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label={`Six treatment blocks in arrival order. The chest-pain block is fifth, beginning at minute ${waitFor(arrival)}.`}>
      {arrival.map((r, i) => (
        <>
          <rect x={x(0)} y={8 + i * ROW} width={Math.max(x(r.start) - x(0), 0)} height="14" rx="2"
            class="q-fill--ink" />
          <rect x={x(r.start)} y={8 + i * ROW} width={x(r.end) - x(r.start)} height="14" rx="2"
            class={r.critical ? "q-fill" : "q-fill--soft"} />
          {r.critical && (
            <rect x={x(r.start) - 2} y={6 + i * ROW} width={x(r.end) - x(r.start) + 4} height="18"
              rx="3" fill="none" class="q-line--gold" />
          )}
        </>
      ))}
    </svg>
  </Panel>

  <Panel
    title="Ordered by urgency"
    note={`Chest pain seen at <b>minute ${waitFor(triaged)}</b>. The wrist waits ${waitFor(arrival) - waitFor(triaged)} minutes longer and lives.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="The same six blocks reordered so the chest-pain block comes first, with every other block pushed later by half an hour.">
      {triaged.map((r, i) => (
        <>
          <rect x={x(0)} y={8 + i * ROW} width={Math.max(x(r.start) - x(0), 0)} height="14" rx="2"
            class="q-fill--ink" />
          <rect x={x(r.start)} y={8 + i * ROW} width={x(r.end) - x(r.start)} height="14" rx="2"
            class={r.critical ? "q-fill" : "q-fill--soft"} />
          {r.critical && (
            <rect x={x(r.start) - 2} y={6 + i * ROW} width={x(r.end) - x(r.start) + 4} height="18"
              rx="3" fill="none" class="q-line--gold" />
          )}
        </>
      ))}
    </svg>
  </Panel>
</Figure>
