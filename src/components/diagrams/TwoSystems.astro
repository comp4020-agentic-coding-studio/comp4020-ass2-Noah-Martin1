---
/**
 * Week 2's opening claim, drawn before the simulation confirms it: two systems
 * with identical throughput and identical average service time, one of which
 * has no queue and one of which has a permanent one. The only difference is
 * how regular the arrivals and service times are.
 *
 * Arrival ticks on a timeline, service blocks underneath, and the resulting
 * queue-length trace at the bottom of each panel.
 */
import Figure from "./Figure.astro";
import Panel from "./Panel.astro";

const W = 300;
const H = 150;
const X0 = 12;
const X1 = W - 12;
const T = 30;
const x = (t: number) => X0 + (t / T) * (X1 - X0);

// Both systems: 10 customers in 30 minutes, mean service 2.4 min. Identical
// load. Only the spacing differs.
const CLOCK = { arrivals: [0, 3, 6, 9, 12, 15, 18, 21, 24, 27], service: Array(10).fill(2.4) };
const REAL = {
  arrivals: [0, 1, 2, 8, 9, 9.5, 10, 19, 20, 27],
  service: [1.2, 4.5, 0.8, 3.9, 1.1, 5.2, 0.6, 2.4, 3.3, 1.0],
};

/** Run a single-server FCFS queue and report the length trace. */
function trace(sys: { arrivals: number[]; service: number[] }) {
  let free = 0;
  const spans = sys.arrivals.map((a, i) => {
    const start = Math.max(a, free);
    free = start + sys.service[i];
    return { a, start, end: free };
  });
  const points: { t: number; n: number }[] = [];
  for (let t = 0; t <= T; t += 0.5) {
    points.push({ t, n: spans.filter((s) => s.a <= t && s.end > t).length });
  }
  return { spans, points, peak: Math.max(...points.map((p) => p.n)) };
}

const clock = trace(CLOCK);
const real = trace(REAL);
const scale = Math.max(clock.peak, real.peak, 1);

const AXIS = 58;
const TRACE_TOP = 74;
const TRACE_H = 48;
const ty = (n: number) => TRACE_TOP + TRACE_H - (n / scale) * TRACE_H;

const path = (pts: { t: number; n: number }[]) =>
  pts.map((p, i) => `${i === 0 ? "M" : "L"} ${x(p.t).toFixed(1)} ${ty(p.n).toFixed(1)}`).join(" ");
---

<Figure
  columns={2}
  caption={`Ten customers in thirty minutes in both panels, and the same average service time in both. The trace at the bottom of each is how many people are in the system. On the left it never rises above the one being served; on the right it reaches ${real.peak}, so ${real.peak - 1} people are queueing. Nothing was added and nothing was removed — the arrivals were simply allowed to be irregular, and the service times allowed to differ. This is why "we are too busy" is so often the wrong diagnosis: both systems are busy to exactly the same degree.`}
>
  <Panel
    title="Clockwork arrivals, identical service"
    note={`Peak queue: <b>${clock.peak - 1 <= 0 ? "nobody ever waits" : clock.peak - 1 + " waiting"}</b>. Utilisation is 80%.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="Evenly spaced arrival marks above a row of equal-length service blocks, with a flat queue-length trace below showing nobody ever waits.">
      {CLOCK.arrivals.map((a) => (
        <line x1={x(a)} y1="14" x2={x(a)} y2="26" class="q-line--gold" />
      ))}
      {clock.spans.map((s) => (
        <rect x={x(s.start)} y="34" width={Math.max(x(s.end) - x(s.start), 1)} height="12" rx="2" class="q-fill--soft" />
      ))}
      <line x1={X0} y1={AXIS} x2={X1} y2={AXIS} class="q-line" />
      <path d={path(clock.points)} class="q-line--gold" />
      <line x1={X0} y1={TRACE_TOP + TRACE_H} x2={X1} y2={TRACE_TOP + TRACE_H} class="q-line" />
    </svg>
  </Panel>

  <Panel
    title="Irregular arrivals, variable service"
    note={`Peak queue: <b>${real.peak - 1} waiting</b>. Utilisation is the same 80%.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label={`Clustered arrival marks above service blocks of differing lengths, with a queue-length trace below that rises to ${real.peak} and falls back repeatedly.`}>
      {REAL.arrivals.map((a) => (
        <line x1={x(a)} y1="14" x2={x(a)} y2="26" class="q-line--gold" />
      ))}
      {real.spans.map((s) => (
        <rect x={x(s.start)} y="34" width={Math.max(x(s.end) - x(s.start), 1)} height="12" rx="2" class="q-fill--soft" />
      ))}
      <line x1={X0} y1={AXIS} x2={X1} y2={AXIS} class="q-line" />
      <path d={path(real.points)} class="q-line--gold" />
      <line x1={X0} y1={TRACE_TOP + TRACE_H} x2={X1} y2={TRACE_TOP + TRACE_H} class="q-line" />
    </svg>
  </Panel>
</Figure>
