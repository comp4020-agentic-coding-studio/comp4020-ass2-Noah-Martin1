---
/**
 * Week 4, drawn: the passport office's costs and the queue's costs, at the
 * same scale, with only one of them appearing in anybody's accounts.
 *
 * The point is the height difference and the dashed outline. One column is
 * money somebody budgeted. The other is money nobody has ever written down.
 */
import Figure from "./Figure.astro";
import Panel from "./Panel.astro";

const APPLICATIONS = 800;
const WAIT_MIN = 90;
const HOURS_PER_DAY = (APPLICATIONS * WAIT_MIN) / 60;
const DAYS = 250;
const HOURS_PER_YEAR = HOURS_PER_DAY * DAYS;
const HOURLY = 40;
const QUEUE_COST = (HOURS_PER_YEAR * HOURLY) / 1_000_000;

// Plausible annual operating costs for an office of this size, in $m.
const LEDGER = [
  { label: "Staff", value: 4.1 },
  { label: "Premises", value: 1.2 },
  { label: "Systems", value: 0.7 },
];
const BOOKED = LEDGER.reduce((s, l) => s + l.value, 0);
const MAX = Math.max(BOOKED, QUEUE_COST);

const W = 200;
const H = 170;
const BASE = H - 26;
const TOP = 12;
const h = (v: number) => ((v / MAX) * (BASE - TOP));
---

<Figure
  columns={2}
  caption={`Both columns are money, both are annual, and they are drawn to the same scale. The office's entire operating budget is on the left. On the right is the value of the time its queue consumes — ${Math.round(HOURS_PER_YEAR).toLocaleString("en-AU")} hours a year, about ${Math.round(HOURS_PER_YEAR / 1800)} people's working lives, at $${HOURLY} an hour. It appears in no budget, no forecast and no performance report, which is exactly why a manager scored on the left-hand column will keep making it taller.`}
>
  <Panel
    title="What the office pays"
    note={`<b>$${BOOKED.toFixed(1)}m</b> a year. Every dollar of it budgeted, forecast and reported.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label={`A stacked bar of the office's operating costs totalling ${BOOKED.toFixed(1)} million dollars, drawn to the same scale as the next panel.`}>
      {LEDGER.map((item, i) => {
        const below = LEDGER.slice(0, i).reduce((s, l) => s + l.value, 0);
        return (
          <rect x={W / 2 - 34} y={BASE - h(below + item.value)} width="68" height={h(item.value)}
            class="q-fill" opacity={0.35 + i * 0.25} />
        );
      })}
      <line x1="16" y1={BASE} x2={W - 16} y2={BASE} class="q-line" />
    </svg>
  </Panel>

  <Panel
    title="What the queue pays"
    note={`<b>$${QUEUE_COST.toFixed(1)}m</b> a year, borne by people who are not party to any of the office's decisions and cannot bill anyone.`}
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label={`A single dashed-outline bar representing the value of the queue's waiting time, roughly ${(QUEUE_COST / BOOKED).toFixed(1)} times the height of the office's entire budget, drawn unfilled because it appears in no account.`}>
      <rect x={W / 2 - 34} y={BASE - h(QUEUE_COST)} width="68" height={h(QUEUE_COST)}
        fill="none" class="q-box q-box--idle" />
      <line x1="16" y1={BASE} x2={W - 16} y2={BASE} class="q-line" />
    </svg>
  </Panel>
</Figure>
