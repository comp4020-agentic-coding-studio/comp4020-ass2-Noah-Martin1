---
/**
 * Week 9: the same person getting the same appointment, before and after the
 * service introduced a booking system, with the window the organisation
 * actually measures marked on each.
 *
 * The published statistic improves by a factor of eleven. The person waits
 * three weeks longer.
 */
import Figure from "./Figure.astro";
import Panel from "./Panel.astro";

const W = 300;
const H = 96;
const X0 = 12;
const X1 = W - 12;

type Leg = { label: string; frac: number; measured: boolean };

const WALK_IN: Leg[] = [
  { label: "Travel and turn up", frac: 0.14, measured: false },
  { label: "Stand in the corridor", frac: 0.72, measured: true },
  { label: "Seen", frac: 0.14, measured: true },
];

const BOOKED: Leg[] = [
  { label: "Wait for the appointment", frac: 0.86, measured: false },
  { label: "Wait in the room", frac: 0.07, measured: true },
  { label: "Seen", frac: 0.07, measured: true },
];

function lay(legs: Leg[]) {
  let at = 0;
  return legs.map((l) => {
    const seg = { ...l, from: at, to: at + l.frac };
    at += l.frac;
    return seg;
  });
}

const walk = lay(WALK_IN);
const book = lay(BOOKED);
const x = (f: number) => X0 + f * (X1 - X0);
const measuredFrom = (segs: ReturnType<typeof lay>) => segs.find((s) => s.measured)!.from;
---

<Figure
  columns={2}
  caption="Both bars are one person getting one appointment. The gold bracket is the only part the service counts as 'waiting time', and in the booked version it has been drawn around a much smaller piece of a much longer wait. Nobody lied: the published figure measures exactly what the service defined it to measure. Little's Law from week 3 is the tool for catching this — apply it at the boundary you care about, not the one the organisation chose."
>
  <Panel
    title="Walk in — 90 minutes in a corridor"
    note="Published average wait: <b>90 minutes</b>. Nobody is happy, and the number is honest."
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="A single timeline bar. Most of it is standing in the corridor, and the measured window covers almost all of it.">
      {walk.map((s) => (
        <rect x={x(s.from)} y="30" width={x(s.to) - x(s.from)} height="20"
          class={s.label === "Seen" ? "q-fill" : "q-fill--soft"} />
      ))}
      <line x1={x(measuredFrom(walk))} y1="60" x2={X1} y2="60" class="q-line--gold" />
      <line x1={x(measuredFrom(walk))} y1="55" x2={x(measuredFrom(walk))} y2="65" class="q-line--gold" />
      <line x1={X1} y1="55" x2={X1} y2="65" class="q-line--gold" />
      <text x={(x(measuredFrom(walk)) + X1) / 2} y="80" text-anchor="middle" class="q-tick">measured</text>
    </svg>
  </Panel>

  <Panel
    title="Booked — 8 minutes, four weeks later"
    note="Published average wait: <b>8 minutes</b>. Also honest. The four weeks are outside the definition."
  >
    <svg viewBox={`0 0 ${W} ${H}`} class="q-svg" role="img"
      aria-label="The same timeline for a booked appointment. Most of the bar is a four-week wait before arriving, and the measured window covers only the small tail after arrival.">
      {book.map((s) => (
        <rect x={x(s.from)} y="30" width={x(s.to) - x(s.from)} height="20"
          class={s.label === "Seen" ? "q-fill" : "q-fill--soft"} />
      ))}
      <line x1={x(measuredFrom(book))} y1="60" x2={X1} y2="60" class="q-line--gold" />
      <line x1={x(measuredFrom(book))} y1="55" x2={x(measuredFrom(book))} y2="65" class="q-line--gold" />
      <line x1={X1} y1="55" x2={X1} y2="65" class="q-line--gold" />
      <text x={x(measuredFrom(book)) - 6} y="80" text-anchor="end" class="q-tick">measured</text>
    </svg>
  </Panel>
</Figure>
