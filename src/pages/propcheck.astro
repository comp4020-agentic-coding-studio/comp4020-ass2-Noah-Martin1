---
/**
 * Scratch page. Renders every prop in the library at the size the scenes
 * actually use, so they can be looked at side by side instead of discovered
 * one at a time inside a week that is also trying to teach something.
 *
 * Deleted before the scenes ship. It deliberately does not carry data-qsim, so
 * it stays out of the simulation allowlist while it exists.
 */
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../site-config";
import "../styles/course.css";
---

<ContentLayout title="Prop check" description="Scratch" {...siteConfig}>
  <h2>Every prop, light and dark</h2>
  <figure class="q-figure" data-propcheck>
    <div class="q-figure__stage">
      <canvas
        data-propcheck-canvas
        role="img"
        aria-label="A grid of the scene prop library: boxes, people, plants, chairs, counters, screens and cars drawn in the course projection."
        style="display:block;width:100%"></canvas>
    </div>
  </figure>
</ContentLayout>

<script>
  import { fitCamera, type Camera, type Extent } from "../lib/scene/project";
  import {
    Stage, box3, car, chair, chip, counter, darken, ground, label, mix,
    person, plant, screen as board, softShadow, type Palette,
  } from "../lib/scene/draw";
  import { tints } from "../lib/scene/draw";
  import { readPalette } from "../lib/scene/palette";


  const CELLS: Array<{
    name: string;
    extent: Extent;
    draw: (c: CanvasRenderingContext2D, cam: Camera, p: Palette) => void;
  }> = [
    {
      name: "ground + grid",
      extent: { x0: 0, x1: 4, y0: 0, y1: 3, z1: 0.5 },
      draw: (c, cam, p) => ground(c, cam, p, { x0: 0, x1: 4, y0: 0, y1: 3, z1: 0.5 }, 1),
    },
    {
      name: "box3: stone, wood, metal, gold",
      extent: { x0: 0, x1: 4, y0: 0, y1: 2.4, z1: 2 },
      draw: (c, cam, p) => {
        const t = tints(p);
        softShadow(c, cam, p, 2, 1.2, 1.6);
        [t.stone, t.wood, t.metal, p.gold].forEach((fill, i) => {
          box3(c, cam, { x: 0.25 + i * 0.95, y: 0.6, w: 0.75, d: 0.9, h: 0.5 + i * 0.3 }, { fill });
        });
      },
    },
    {
      name: "person: waiting / served",
      extent: { x0: 0, x1: 3, y0: 0, y1: 2, z1: 2 },
      draw: (c, cam, p) => {
        const t = tints(p);
        const cast = [
          { coat: mix(p.ink, p.bg, 0.2), hair: darken(t.clay, 0.3) },
          { coat: mix(p.green, p.bg, 0.3), hair: mix(p.ink, p.bg, 0.1), carry: t.wood },
          { coat: p.gold, hair: darken(t.wood, 0.4) },
        ];
        cast.forEach((who, i) => {
          const x = 0.6 + i * 0.9;
          softShadow(c, cam, p, x, 1, 0.3);
          person(c, cam, p, x, 1, { ...who, skin: mix(t.skin, p.ink, i * 0.18) });
        });
      },
    },
    {
      name: "person at small scale",
      extent: { x0: 0, x1: 12, y0: 0, y1: 3, z1: 2 },
      draw: (c, cam, p) => {
        for (let i = 0; i < 14; i++) {
          const x = 0.5 + i * 0.8;
          person(c, cam, p, x, 1.5, { coat: i === 13 ? p.gold : mix(p.ink, p.bg, 0.3) });
        }
      },
    },
    {
      name: "plant",
      extent: { x0: 0, x1: 3, y0: 0, y1: 2, z1: 1.5 },
      draw: (c, cam, p) => {
        [[0.7, 1], [1.7, 1.2], [2.5, 0.8]].forEach(([x, y], i) => {
          softShadow(c, cam, p, x, y, 0.32);
          plant(c, cam, p, x, y, 1 + i * 0.35, i + 1);
        });
      },
    },
    {
      name: "counter + chairs",
      extent: { x0: 0, x1: 3.6, y0: 0, y1: 3, z1: 1.6 },
      draw: (c, cam, p) => {
        const st = new Stage();
        st.add(1.2, 2.9, () => person(c, cam, p, 1.2, 2.9, { coat: p.gold }));
        st.add(1.8, 1.9, () => counter(c, cam, p, { x: 0.2, y: 1.9, w: 3.2, d: 0.7, h: 1.05 }));
        [0.7, 1.7, 2.7].forEach((x) => st.add(x, 0.5, () => chair(c, cam, p, x, 0.5)));
        st.paint();
      },
    },
    {
      name: "screen",
      extent: { x0: 0, x1: 4, y0: 0, y1: 2, z1: 3 },
      draw: (c, cam, p) => {
        board(c, cam, p, { x: 0.6, y: 1, w: 2.8, h: 1.1, z: 1.5, lines: ["NOW SERVING", "B 4 1"] });
      },
    },
    {
      name: "car queue",
      extent: { x0: 0, x1: 16, y0: 0, y1: 3.4, z1: 2.2 },
      draw: (c, cam, p) => {
        const paints = [mix(p.ink, p.bg, 0.3), p.gold, mix(p.green, p.bg, 0.2)];
        for (let i = 0; i < 3; i++) {
          const x = 0.4 + i * 5.2;
          softShadow(c, cam, p, x + 2.1, 1.3, 2.1, 0.7);
          car(c, cam, p, x, 0.6, paints[i]);
        }
      },
    },
    {
      name: "chip",
      extent: { x0: 0, x1: 4, y0: 0, y1: 2, z1: 1 },
      draw: (c, _cam, p) => {
        const at = { x: 12, y: 30 };
        chip(c, p, "L = 4.2", at.x, at.y);
        chip(c, p, "W = 3 min", at.x, at.y + 28);
        chip(c, p, "ρ = 0.92", at.x, at.y + 56);
      },
    },
  ];

  function setup() {
    const root = document.querySelector<HTMLElement>("[data-propcheck]");
    const canvas = root?.querySelector<HTMLCanvasElement>("[data-propcheck-canvas]");
    const ctx = canvas?.getContext("2d");
    if (!root || !canvas || !ctx) return;

    function draw() {
      const p = readPalette(root!);
      const cols = root!.clientWidth > 720 ? 3 : 1;
      const rows = Math.ceil(CELLS.length / cols);
      const cellW = root!.clientWidth / cols;
      const cellH = 190;
      const w = root!.clientWidth;
      const h = rows * cellH;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.height = `${h}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, w, h);

      CELLS.forEach((cell, i) => {
        const cx = (i % cols) * cellW;
        const cy = Math.floor(i / cols) * cellH;
        ctx!.save();
        ctx!.translate(cx, cy);
        ctx!.strokeStyle = p.rule;
        ctx!.lineWidth = 1;
        ctx!.strokeRect(0.5, 0.5, cellW - 1, cellH - 1);
        label(ctx!, cell.name, 10, 18, p.soft, 11, "left", "600");
        const cam = fitCamera(cellW, cellH - 26, cell.extent, 16);
        cam.oy += 20;
        cell.draw(ctx!, cam, p);
        ctx!.restore();
      });
    }

    draw();
    new MutationObserver(draw).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window.addEventListener("resize", draw);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
